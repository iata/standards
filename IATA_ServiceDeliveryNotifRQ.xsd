  <xs:simpleType name="ServiceDeliveryStatusCodeContentType">
    <xs:annotation>
      <xs:documentation>Shows the possible statuses of a service delivery item. </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="CONFIRMED">
        <xs:annotation>
          <xs:documentation>Inventory owner confirms he is able to provide the Service.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DELIVERED">
        <xs:annotation>
          <xs:documentation>Service has been successfully delivered.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EXPIRED">
        <xs:annotation>
          <xs:documentation>Service is no longer available for delivery.
 Service purchased with an associated time limit for consumption and Service was never claimed.
 Service having been at least Confirmed is no longer available as the Customer did not claim the Service within a specific time period, as dictated by the Airline.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FAILED TO DELIVER">
        <xs:annotation>
          <xs:documentation>Service could not be delivered due to Airline's or provider limitations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="IN PROGRESS">
        <xs:annotation>
          <xs:documentation>The Delivery Provider is in the process of delivering the Service.
 There is a universal concept that the 'In progress' status may block any further financial transactions; e.g. refund.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NOT CLAIMED">
        <xs:annotation>
          <xs:documentation>The Service has not been claimed by the Passenger for reasons as a result of Passenger action or inaction. e.g. Passenger no-show, etc.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="READY TO DELIVER">
        <xs:annotation>
          <xs:documentation>Provider is in a position to start delivery of the Service.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="READY TO PROCEED">
        <xs:annotation>
          <xs:documentation>OM is in a position to allow a Delivery Provider to prepare the Service.
 Customer is entitled to receive the Service. This is typically a trigger for ORA to begin accounting process.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REMOVED">
        <xs:annotation>
          <xs:documentation>Service was deleted.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REQUESTED">
        <xs:annotation>
          <xs:documentation>OM requests the Service from the Inventory owner.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SUSPENDED">
        <xs:annotation>
          <xs:documentation>Delivery of the Service is suspended as a result of an Airline decision. 
 Can only revert back to the previous status.
 Exception is that Suspended may go to Removed. 
 This status may be used in case of fraud detection.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNABLE TO DELIVER">
        <xs:annotation>
          <xs:documentation>It is not possible for the Delivery Provider to deliver a Service. This could be for reasons of availability, legal or regulatory constraint.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ServiceDeliveryStatusCodeType">
    <xs:annotation>
      <xs:documentation>Represents the current status of a service delivery item</xs:documentation>
    </xs:annotation>
    <xs:restriction base="ServiceDeliveryStatusCodeContentType" />
  </xs:simpleType>
