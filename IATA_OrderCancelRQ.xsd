        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="DiscountPercent" type="PercentType">
        <xs:annotation>
          <xs:documentation>Discount percentage applied to the price.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="PreDiscountedAmount" type="AmountType">
