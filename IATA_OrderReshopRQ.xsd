        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="FlightCharacteristicsCriteria" type="FlightCharacteristicsCriteriaType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 when related to Flight Characteristics Criteria
 Flight filter criteria including aircraft features, Cabin Type, RBD, and Tail Number.
 </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="IATA_AircraftType" type="IATA_AircraftTypeType">
