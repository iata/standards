        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="UpdateOrder" type="UpdateOrderType">
        <xs:annotation>
          <xs:documentation>Update Order Option to Reshop or Reprice an Order.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ReshopOrderChoiceType">
    <xs:annotation>
      <xs:documentation>Reshop order Choice</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element minOccurs="1" maxOccurs="1" name="ServiceOrder" type="ServiceOrderType">
        <xs:annotation>
          <xs:documentation>Functions to allow a Seller to request additions, replacement or deletions of OrderItems in this specific Order.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="UpdatePax" type="UpdatePaxType">
        <xs:annotation>
          <xs:documentation>Function to Add, Remove or Update the Passenger Details. Providing the New and Previous values together implies an Update.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="UpdatePaxName" type="UpdatePaxNameType">
        <xs:annotation>
