          <xs:documentation>Unique Agency Seller ID. Example: CTRV</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="ContactInfo" type="ContactInfoType">
