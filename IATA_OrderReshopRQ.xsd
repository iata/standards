        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="ReshopOrder" type="ReshopOrderType" />
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="UpdatePaxNameType">
    <xs:annotation>
      <xs:documentation>Request to Airline whether any fees will apply to a proposed correction to a Passenger's name details.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="5" name="GivenName" type="ProperNameType">
        <xs:annotation>
          <xs:documentation>A personal name given to the individual at birth and used before a family name. Also called first name. E.g. JOHN.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="3" name="MiddleName" type="ProperNameType">
        <xs:annotation>
          <xs:documentation>Individual's middle name or initial. E.g. G, GEORGE.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="unbounded" name="PaxRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to the Passenger ID for whom the name change is requested.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="SuffixName" type="SupplementNameType">
        <xs:annotation>
          <xs:documentation> Individual's name suffixes and letters. Examples: Jr., Sr., III, Ret., Esq.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="Surname" type="ProperNameType">
        <xs:annotation>
          <xs:documentation>Individual's hereditary name(s) common to all members of a family. Also known as family name or last name. E.g. SMITH. Excludes any potential suffix.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="TitleName" type="SupplementNameType">
        <xs:annotation>
          <xs:documentation>A word such as Mr., Mrs., Miss or Dr that is used before an individual's name to indicate the gender, profession or marital status.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="UpdatePaxType">
    <xs:annotation>
      <xs:documentation>Function to Add, Remove or Update the Passenger Details. Providing the New and Previous values together implies an Update.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="PaxSharingPref" type="PaxSharingPrefType">
        <xs:annotation>
          <xs:documentation>This will be used to identify a Passenger's sharing preference.
 The passenger can request that his/her information is not shared with other passengers in the same order. 
 Additionally the passenger can be in a requested selected group of passengers whom wish to not share with the remaining passengers in the booking . E.g could be a group of a family members in a larger group booking.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="URI_Type">
