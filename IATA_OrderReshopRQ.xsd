 Example: $4 per flight segment, per passenger (U.S. domestic segment tax)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="FiledAmount" type="AmountType">
        <xs:annotation>
          <xs:documentation>Internal tax filed amount as determined by the airline.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="FiledTaxCode" type="TaxCodeType">
        <xs:annotation>
          <xs:documentation>Internal tax filed type code as determined by the airline.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="QualifierCode" type="TaxQualifierCodeType">
