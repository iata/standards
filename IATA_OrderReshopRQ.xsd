          <xs:documentation>Bank Account payment method definition.
 Customer bank accounts for payments, either for paper checks or electronic funds transfer.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="OriginalPaymentMethodInd" type="IndType" />
      <xs:element minOccurs="0" maxOccurs="1" name="PaymentCard" type="PaymentCard1Type">
        <xs:annotation>
          <xs:documentation>A device that enables its owner (the cardholder) to make a payment by electronic funds transfer.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="PrefLevel" type="PrefLevelType">
        <xs:annotation>
          <xs:documentation>Information supporting a preference including preference level code (e.g. Preferred, Exclude, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="TypeCode" type="PaymentMethodCodeType">
        <xs:annotation>
          <xs:documentation>The payment method type. Examples: Credit Card, Cash.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RemarkType">
    <xs:annotation>
      <xs:documentation>Additional, supplementary information about the document or service.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="DisplayInd" type="IndType">
        <xs:annotation>
          <xs:documentation>When TRUE, this remark should be displayed.
 
 Notes:
 1. This capability may not be supported by all NDC-enabled systems or may be supported by bilateral agreement only. The technical implementation of this capability is not dictated by this specification.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="RemarkText" type="TextType">
        <xs:annotation>
          <xs:documentation>Additional, supplementary information about the document or service.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="Timestamp" type="DateTimeType">
        <xs:annotation>
          <xs:documentation>Remark creation timestamp.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RepriceOrderType">
    <xs:annotation>
      <xs:documentation>Function to reprice entire Order (if only OrderID is supplied within Request) or Specific OrderItems (if defined in nested OrderItem elements)</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="OrderItemRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Optionally specify which OrderItem needs to be repriced.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RequestType">
    <xs:annotation>
      <xs:documentation>Request content for message</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="BookingRef" type="BookingRefType">
        <xs:annotation>
          <xs:documentation>Information related to a booking or reservation.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="OrderActionContextText" type="TextType">
