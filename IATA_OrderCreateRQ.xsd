          <xs:documentation>IATA assigned code identifying the system used to price the itinerary for the document being issued.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="StatisticalCodeText" type="TextType">
        <xs:annotation>
          <xs:documentation>Code used for domestic or international sales differentiation.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="TourCode" type="CodeType">
        <xs:annotation>
          <xs:documentation>Tour Code. Example: ITGF12</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="FareGroupType">
    <xs:annotation>
      <xs:documentation>Change to 'Defines types of fares. Examples include: Defines types of fares. Examples include: Published Fares, Dynamic Discounted Fares, Negotiated Fares, One Way Fare, Private Fares</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="FareCode" type="CodeType">
        <xs:annotation>
          <xs:documentation>Fare Type Code.
 Examples:
 70J - Published Fares
 70K - Dynamic Discounted Fares
 749 - Negotiated Fares
 756 - One Way Fare
 758 - Private Fares
 Encoding Scheme: PADIS codeset element 9910 - Fare Qualifier</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="FareDetail" type="FareDetailType">
