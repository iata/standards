          <xs:documentation>When true, this tax must be collected.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="CollectionPointTax" type="CollectionPointTaxType">
        <xs:annotation>
          <xs:documentation>Tax data breakdown by collection point for XF(Passenger Facility Fee) and ZP(federal tax segment) taxes.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="Country" type="CountryType">
        <xs:annotation>
          <xs:documentation>A nation with its own government, occupying a particular territory.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="CountrySubDivision" type="CountrySubDivisionType">
