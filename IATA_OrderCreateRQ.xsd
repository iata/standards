          <xs:documentation>The fare calculation text required in the fare calculation area of an electronic ticket.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="PricingCodeText" type="TextType">
