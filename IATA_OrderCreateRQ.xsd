          <xs:documentation>Fare basis application. Examples: Requested, Ticketed, Other.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="FareBasisCode" type="CodeType">
