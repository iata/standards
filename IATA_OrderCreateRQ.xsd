          <xs:documentation>Corporate ID used for pricing special fares. Example: 675124</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="FareCalculationInfo" type="FareCalculationInfoType">
