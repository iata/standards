        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="Request" type="RequestType">
          <xs:annotation>
            <xs:documentation>Order Create request information.</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
