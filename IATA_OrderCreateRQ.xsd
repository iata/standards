        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="FareGroupID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Unique identifier for this Fare Group</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="FareListType">
    <xs:annotation>
      <xs:documentation>Fare List definition</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="unbounded" name="FareGroup" type="FareGroupType">
        <xs:annotation>
          <xs:documentation>Change to 'Defines types of fares. Examples include: Defines types of fares. Examples include: Published Fares, Dynamic Discounted Fares, Negotiated Fares, One Way Fare, Private Fares</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="FarePriceTypeType">
    <xs:annotation>
      <xs:documentation>The type of fair price applied to a Fare Detail (e.g. filed amount, net amount, or a sell amount).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="FarePriceTypeCode" type="CodeType">
