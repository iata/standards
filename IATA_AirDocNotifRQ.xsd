        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="VersionNumber" type="NumberType">
        <xs:annotation>
          <xs:documentation>For all IATA versioned messages, the version of the message is indicated by a decimal value.</xs:documentation>
        </xs:annotation>
      </xs:element>
