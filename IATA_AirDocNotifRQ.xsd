        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="PTC" type="IATA_PTC_CodeType">
        <xs:annotation>
          <xs:documentation>Type code applying to the Passenger which typically drives pricing (e.g. ADT, CHD, etc).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="RedressCase" type="RedressCaseType">
