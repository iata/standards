        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="TotalQty" type="QtyType">
        <xs:annotation>
          <xs:documentation>Maximum pieces of baggage allowed.
 Example: 4</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="TypeText" type="TextType">
        <xs:annotation>
          <xs:documentation>Type of bag. Example: Golf Equipment, Fishing Bag, Car Seat, etc.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
