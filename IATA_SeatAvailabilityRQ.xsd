      <xs:element minOccurs="1" maxOccurs="1" name="RetailPartner" type="RetailPartnerType">
        <xs:annotation>
          <xs:documentation>A company that partners with a manufacturer or producer to market and sell the manufacturer's products, services, or technologies.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="TravelAgency" type="TravelAgencyType">
        <xs:annotation>
          <xs:documentation>A private retailer or public service that provides travel and tourism related services to the public on behalf of suppliers such as activities, airlines, car rentals, cruise lines, hotels, railways, travel insurance, and package tours.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
  </xs:complexType>
  <xs:simpleType name="ServiceBookingStatusCodeContentType">
    <xs:annotation>
      <xs:documentation>shows the possible statuses of a service Booking item. </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="CONFIRMED">
        <xs:annotation>
          <xs:documentation>Inventory owner confirms he is able to provide the Service.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REQUESTED">
        <xs:annotation>
          <xs:documentation>OM requests the Service from the Inventory owner.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ServiceBookingStatusCodeType">
    <xs:annotation>
      <xs:documentation>Represents the current status of a service booking item</xs:documentation>
    </xs:annotation>
    <xs:restriction base="ServiceBookingStatusCodeContentType" />
  </xs:simpleType>
  <xs:complexType name="ServiceCriteriaType">
    <xs:annotation>
      <xs:documentation>Reason for Issuance Group and Subgroup code(s) that specify the requested categories of Optional Services to be returned in the results.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="IncludeInd" type="IndType">
        <xs:annotation>
          <xs:documentation>When TRUE, specified service should be included in search results. When FALSE, exclude shopping results including the specified service.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="PrefLevel" type="PrefLevelType">
        <xs:annotation>
          <xs:documentation>Information supporting a preference including preference level code (e.g. Preferred, Exclude, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="RFIC" type="RFIC_CodeType">
        <xs:annotation>
          <xs:documentation>Reason For Issuance Code 
 Examples:
 A (Air Transportation)
 C (Baggage)
 E (Airport Services)
 F (Merchandise)
 G (In-flight Services)
 Refer to PADIS Codeset for data element 4183 - Special Condition.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="RFISC" type="RFISC_CodeType">
        <xs:annotation>
          <xs:documentation>Reason For Issuance Sub Code.
 Examples:
 0CC (First Checked Bag)
 0B1 (In-flight Entertainment)
 0BX (Lounge)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ServicePricingOnlyInd" type="IndType">
        <xs:annotation>
          <xs:documentation>When TRUE, service pricing only is requested.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="TaxonomyCode" type="CodeType">
        <xs:annotation>
          <xs:documentation>Used for defining a product or service within the Shared Industry Taxonomy or bilaterally.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="ServiceDeliveryStatusCodeContentType">
    <xs:annotation>
      <xs:documentation>Shows the possible statuses of a service delivery item. </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:enumeration value="CONFIRMED">
        <xs:annotation>
          <xs:documentation>Inventory owner confirms he is able to provide the Service.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DELIVERED">
        <xs:annotation>
          <xs:documentation>Service has been successfully delivered.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EXPIRED">
        <xs:annotation>
          <xs:documentation>Service is no longer available for delivery.
 Service purchased with an associated time limit for consumption and Service was never claimed.
 Service having been at least Confirmed is no longer available as the Customer did not claim the Service within a specific time period, as dictated by the Airline.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FAILED TO DELIVER">
        <xs:annotation>
          <xs:documentation>Service could not be delivered due to Airline's or provider limitations.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="IN PROGRESS">
        <xs:annotation>
          <xs:documentation>The Delivery Provider is in the process of delivering the Service.
 There is a universal concept that the 'In progress' status may block any further financial transactions; e.g. refund.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NOT CLAIMED">
        <xs:annotation>
          <xs:documentation>The Service has not been claimed by the Passenger for reasons as a result of Passenger action or inaction. e.g. Passenger no-show, etc.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="READY TO DELIVER">
        <xs:annotation>
          <xs:documentation>Provider is in a position to start delivery of the Service.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="READY TO PROCEED">
        <xs:annotation>
          <xs:documentation>OM is in a position to allow a Delivery Provider to prepare the Service.
 Customer is entitled to receive the Service. This is typically a trigger for ORA to begin accounting process.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REMOVED">
        <xs:annotation>
          <xs:documentation>Service was deleted.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="REQUESTED">
        <xs:annotation>
          <xs:documentation>OM requests the Service from the Inventory owner.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SUSPENDED">
        <xs:annotation>
          <xs:documentation>Delivery of the Service is suspended as a result of an Airline decision. 
 Can only revert back to the previous status.
 Exception is that Suspended may go to Removed. 
 This status may be used in case of fraud detection.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="UNABLE TO DELIVER">
        <xs:annotation>
          <xs:documentation>It is not possible for the Delivery Provider to deliver a Service. This could be for reasons of availability, legal or regulatory constraint.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ServiceDeliveryStatusCodeType">
    <xs:annotation>
      <xs:documentation>Represents the current status of a service delivery item</xs:documentation>
    </xs:annotation>
    <xs:restriction base="ServiceDeliveryStatusCodeContentType" />
  </xs:simpleType>
  <xs:complexType name="SettlementDataType">
    <xs:annotation>
      <xs:documentation>Amounts that define the funds to be cleared as a result of the payment commitment and the selected payment method, and the date when the funds must be remitted.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="NetClearanceAmount" type="AmountType">
        <xs:annotation>
          <xs:documentation>The amount agreed to be cleared in the Agreement between the two parties to the Agreement. It is obtained from the Commitment in the Agreement. The value of the Net Clearance Amount in the Payment Commitment of the Agreement can be either positive [+] or negative [-]. If it is positive [+] then the party initiating the clearance request will be the Payee in the clearance, i.e. the initiator of the clearance is to receive funds. If it is negative [-] then the party initiating the clearance request will be the Payer in the clearance, i.e. the initiator of the clearance has to pay-out funds. It is the absolute value of the Net Clearance Amount that is used in the Clearance.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="RemittanceDate" type="DateType">
        <xs:annotation>
          <xs:documentation>This is the date when the Payer will have to transfer the amount in the clearance request into the settlement manager's bank account.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingCriteriaType">
    <xs:annotation>
      <xs:documentation>Further qualifies the flight request by influencing which results are returned in the shopping response, including preferred or required criteria.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="OfferItemTypeCriteria" type="OfferItemTypeCriteriaType">
        <xs:annotation>
          <xs:documentation>A given shopping criteria may have 1 or more offer item types.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="PaymentMethodCriteria" type="PaymentMethodCriteriaType">
        <xs:annotation>
          <xs:documentation>A form of procedure for the payment of goods or services, plus any transactional information specific to the payment method other than the amount.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="SeatCriteria" type="ShoppingRequestSeatType">
        <xs:annotation>
          <xs:documentation>Shopping Request specialization of Seat
 Base type definition:
 A sitting place for a passenger or crew in a cabin compartment on a transport vehicle.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ServiceCriteria" type="ServiceCriteriaType">
        <xs:annotation>
          <xs:documentation>Reason for Issuance Group and Subgroup code(s) that specify the requested categories of Optional Services to be returned in the results.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="SpecialNeedsCriteria" type="SpecialServiceType">
        <xs:annotation>
          <xs:documentation>Special service information</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="TripPurposeCode" type="TripPurposeCodeType">
        <xs:annotation>
          <xs:documentation>Trip purpose information (e.g. Business, Leisure, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestAllianceType">
    <xs:annotation>
      <xs:documentation>Shopping Request specialization of Alliance
 Base type definition:
 Two or more airlines participating in a commercial relationship or joint venture, where a joint and commonly identifiable product is marketed under a single commercial name or brand.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="AllianceCode" type="AllianceCodeType">
        <xs:annotation>
          <xs:documentation>Used to specify the alliance based on PADIS Code List 9906</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="Name" type="ProperNameType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Alliance name. Example: One World Alliance</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="URL" type="URI_Type">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Alliance information URL.
 Example: http://www.oneworld.com/home</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestCabinTypeType">
    <xs:annotation>
      <xs:documentation>Shopping Request specialisation of Cabin Type
 base type definition:
 Type of compartment of an aircraft, offering specific services (e.g. business class, economy).
 Business Identifier Fields:
 - Cabin Type Code</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="CabinTypeCode" type="CabinTypeCodeType">
        <xs:annotation>
          <xs:documentation>Cabin Type Code as defined by PADIS codeset 9873 (e.g. 1,2,3 etc)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="CabinTypeName" type="NameType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Name given to a cabin compartment (e.g. Business, First, Economy).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="PrefLevel" type="PrefLevelType">
        <xs:annotation>
          <xs:documentation>Information supporting a preference including preference level code (e.g. Preferred, Exclude, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestDatedMarketingSegmentType">
    <xs:annotation>
      <xs:documentation>This is a Shopping Request specialisation of Dated Marketing Segment.
 Base type definition:
 The commercial designation under which a Dated Operating Segment can be booked, either under the operating carrier's designator or that of another carrier (codeshare).
 Business Identifier Fields:
 - (Marketing) [Carrier] Airline Designator
 - Marketing Carrier Flight Number
 - Operational Suffix
 - [Transport Departure] Scheduled Date Time
 - (Transport Departure) [Station] IATA Location Code
 - (Transport Arrival) [Station] IATA Location Code</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="CabinOrRBD" type="CabinOrRBD_Type">
        <xs:annotation>
          <xs:documentation>Cabin or RBD choice</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="Carrier" type="CarrierType">
        <xs:annotation>
          <xs:documentation>The organization which carries the passenger, baggage, or goods, and/or commits to delivering the carriage as well as any related services such as issuance of ticket, creation of Order, etc.
 Business Identifier Fields :
 - Airline Designator Code
 - Duplicate Designator Indicator
 - Name</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="MarketingCarrierFlightNumberText" type="FlightNumberTextType">
        <xs:annotation>
          <xs:documentation>The numerical designation of a flight as it is marketed by a carrier.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="OperationalSuffixText" type="OperationalSuffixTextType" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestDatedOperatingSegmentType">
    <xs:annotation>
      <xs:documentation>Shopping Request specialization of Dated Operating Segment
 Base type definition:
 An operation between board point and any subsequent off point within the same flight designator. Could be one or more legs. Could also be used for other transport vehicles such as train or bus etc.
 Business Identifier Fields:
 - (Operating) [Carrier] Airline Designator
 - Operating Carrier Flight Number
 - Operational Suffix
 - [Transport Departure] Scheduled Date Time
 - (Transport Departure) [Station] IATA Location Code
 - (Transport Arrival) [Station] IATA Location Code</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="Carrier" type="CarrierType">
        <xs:annotation>
          <xs:documentation>The organization which carries the passenger, baggage, or goods, and/or commits to delivering the carriage as well as any related services such as issuance of ticket, creation of Order, etc.
 Business Identifier Fields :
 - Airline Designator Code
 - Duplicate Designator Indicator
 - Name</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="OperatingCarrierFlightNumberText" type="FlightNumberTextType">
        <xs:annotation>
          <xs:documentation>The numerical designation of a flight as it is operated by a carrier.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="OperationalSuffixText" type="OperationalSuffixTextType">
        <xs:annotation>
          <xs:documentation>Used to distinguish two flights having the same flight number and departing from their respective Origin Stations on the same date.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="RBD_Code" type="RBD_CodeType">
        <xs:annotation>
          <xs:documentation>Code used to identify a particular RBD (e.g. P, J, W, M, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestOfferItemType">
    <xs:annotation>
      <xs:documentation>This is a specialized offer item used in the context of a Shopping Request.
 Generic offer item definition is:
 A priced grouping of one or more services within an Offer.
 The Offer Item assigns a total price for all included services for all passengers and all segments referenced. Once constructed, the OfferItem cannot be modified.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="OfferItemID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Carrier assigned ID which exists uniquely within an Offer.
 Exceeding 64 characters or use of dashes is not recommended.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="OwnerCode" type="AirlineDesigCodeType">
        <xs:annotation>
          <xs:documentation>Deprecation 21.1 Airline code assigned to a carrier. Either ICAO-defined 3-character code or IATA-defined 2-character code.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Service" type="ShoppingRequestServiceType">
        <xs:annotation>
          <xs:documentation>This is a specialized offer used in the context of a Shopping Request.
 Generic definition is:
 The instance of a specific flight or Service Definition as it has been offered (and eventually ordered and consumed) in the context of a specific Offer and/or Order.
 At the time of shopping, a service can be sold to multiple passengers on a given journey. 
 At time of order, the services should be applied to a single passenger on a single segment.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestOfferType">
    <xs:annotation>
      <xs:documentation>This is a specialized offer used in the context of a Shopping Request.
 Generic offer definition is:
 A proposal to sell a specific set of products or Services under specific conditions, for a certain price. Can be the response to a shopping request. 
 Can be a regular Offer or an A La Carte Offer. A La Carte Offer is defined as a container for A La Carte Offer Items. This supports a shopping basket concept for non-flight services. The main purpose of this structure is to reduce the size of the messages by inserting Offer Items which are applicable to multiple flight-related Offers.
 NB. For the OfferID of the ALaCarteOffer: Default OfferID identifier for A La Carte Offer Items in a scenario where items here are not selected for a flight-related Offer above.
 Business Identifier Fields :
 - [Shopping Response] Shopping Response ID 
 - Offer ID
 - [Carrier] Airline Designator Code</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="DatedOperatingLegRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to a Leg ID from a previously returned Offer.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="OfferID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Carrier assigned ID which uniquely identifies a specific Offer across several messages.
 Offer ID facilitates the tracking and verification of individually priced offer(s) selected from the shopping response. Only the Offer IDs of the ORA (Offer Responsible Airline) are returned in shopping responses.
 Offer ID is unique to each individually priced offer in the shopping response even if the offer price is zero.
 Offer ID may be specific to individual passengers in the offer, and may be associated with a segment or a journey.
 The set of Offer IDs returned in a response are referenced by a Shopping Response ID.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="unbounded" name="OfferItem" type="ShoppingRequestOfferItemType">
        <xs:annotation>
          <xs:documentation>This is a specialized offer item used in the context of a Shopping Request.
 Generic offer item definition is:
 A priced grouping of one or more services within an Offer.
 The Offer Item assigns a total price for all included services for all passengers and all segments referenced. Once constructed, the OfferItem cannot be modified.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="OwnerCode" type="AirlineDesigCodeType">
        <xs:annotation>
          <xs:documentation>Airline code assigned to a carrier. Either ICAO-defined 3-character code or IATA-defined 2-character code.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="PaxRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to a Passenger ID from a previously returned Offer.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="PaxSegmentRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to a Passenger Segment ID from a previously returned Offer.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ShoppingResponseRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to unique shopping session response ID, as provided in the airline's previous shopping response.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestOrderItemType">
    <xs:annotation>
      <xs:documentation>This is a specialized order item used in the context of a Shopping Request.
 Generic order item definition is:
 An individually priced item within an Order, made up of one or more Services. May or may not be a selected Offer Item (e.g. non-chargeable Services available on request such as a wheelchair).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="CabinTypeUpgrade" type="ShoppingRequestCabinTypeType">
        <xs:annotation>
          <xs:documentation>Shopping Request specialisation of Cabin Type
 base type definition:
 Type of compartment of an aircraft, offering specific services (e.g. business class, economy).
 Business Identifier Fields:
 - Cabin Type Code</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ChangeGroupID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to one Order Item that are going to be replaced, unique within Order</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ChangeTypeText" type="TextType">
        <xs:annotation>
          <xs:documentation>indicates whether the Order Item is the old or the new Order Item</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="CreationDateTime" type="DateTimeType">
        <xs:annotation>
          <xs:documentation>Order Item creation Timestamp.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="DepositTimeLimitDateTime" type="DateTimeType">
        <xs:annotation>
          <xs:documentation>The date by which a deposit must be paid for an order item.
 Examples: 2015-01-13T13:59:38Z</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="Desc" type="DescType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 
 Description
 An account or representation of the certain or major aspects, characteristics, or features of a person, object, or event.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="DisclosureRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>References a Disclosure ID.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="NamingTimeLimitDateTime" type="DateTimeType">
        <xs:annotation>
          <xs:documentation>The time by which an Order Item must be completed with individual passenger names.
 Examples: 2015-01-13T13:59:38Z</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="OrderItemID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Carrier assigned ID which exists uniquely within an Order.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="OwnerCode" type="AirlineDesigCodeType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Airline code assigned to a carrier. Either ICAO-defined 3-character code or IATA-defined 2-character code.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="OwnerTypeCode" type="OwnerTypeCodeType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Indicates whether or not the owner is the ORA or POA.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="PaxGroup" type="PaxGroupType">
        <xs:annotation>
          <xs:documentation>A number of individual passengers traveling under one commercial name that associates them. E.g. a Tour group or a group for sales allotment from airline to agency.
 Group bookings are subject to special booking rules and may be eligible for special fare rules. Usage and nature of groups is left to bilateral agreements.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="PaymentTimeLimitDateTime" type="DateTimeType">
        <xs:annotation>
          <xs:documentation>The time limit by which a commitment to pay must be made for the given Order Item. Upon expiry it is expected that the Order item is removed from the Order. If no value is returned, then no advice has been given.
 
 For example: PaymentTimeLimitDateTime: 2015-01-01T12:53:12Z - indicates the date time by which payment commitment is required.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="PenaltyRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to a Penalty ID.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="PriceGuaranteeTimeLimitDateTime" type="DateTimeType">
        <xs:annotation>
          <xs:documentation>The length of time the price of an Order Item is guaranteed. In the absence of the price guarantee time limit, the price is not guaranteed. Upon expiry, the price may no longer be guaranteed and either the Order should be repriced, which may result in a new RepricedOffer, or a new shopping process may begin.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="unbounded" name="Service" type="OrderServiceType">
        <xs:annotation>
          <xs:documentation>The instance of a specific flight or Service Definition as it has been offered (and eventually ordered and consumed) in the context of a specific Offer and/or Order.
 At the time of shopping, a service can be sold to multiple passengers on a given journey. 
 At time of order, the services should be applied to a single passenger on a single segment.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="SpecialService" type="SpecialServiceType">
        <xs:annotation>
          <xs:documentation>Special service information</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="StatusCode" type="OrderItemStatusCodeType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Indicates the current status of an Order Item.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="WebAddressURI" type="URI_Type">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Deep linking into another site to complete the transaction. E.g. to bring the customer directly to a page to continue with a purchase of a specific offer.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestOrderType">
    <xs:annotation>
      <xs:documentation>This is a specialized order used in the context of a Shopping Request.
 Generic order definition is:
 A uniquely identified record of the agreement of one party with another to receive products and services under specified terms and conditions. Order supports the sale of a flexible range of airline products and services that are not necessarily Journey based (e.g. subscription services). 
 Comment:
 A 'PNR', 'super PNR' and 'ticket' are all today's versions of airline implementations of aspects of an Order. 
 An Order may support non-homogeneity, i.e. each passenger in an Order may hold different sets of order items at different prices.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="BookingRef" type="BookingRefType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 when related to Shopping Request Order
 Information related to a booking or reservation.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="OrderID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Carrier assigned ID which uniquely identifies a specific Order across several messages.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="OrderItem" type="ShoppingRequestOrderItemType">
        <xs:annotation>
          <xs:documentation>This is a specialized order item used in the context of a Shopping Request.
 Generic order item definition is:
 An individually priced item within an Order, made up of one or more Services. May or may not be a selected Offer Item (e.g. non-chargeable Services available on request such as a wheelchair).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="OwnerCode" type="AirlineDesigCodeType">
        <xs:annotation>
          <xs:documentation>Airline code assigned to a carrier. Either ICAO-defined 3-character code or IATA-defined 2-character code.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestOrgType">
    <xs:annotation>
      <xs:documentation>Shopping Request specialisation of the organisation type.
 base type def:
 An organized structure set up for a particular purpose, such as a business, government body, department, charity, or financial institution.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="ContactInfo" type="ContactInfoType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 when related to Shopping Request Organization
 The electronic or geographic address which a party has provided as the contact channel. For example, contact email, contact postal address, contact phone number.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="Name" type="NameType">
        <xs:annotation>
          <xs:documentation>Name of the organization</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="OrgID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Organization code or identifier.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestPaxSegmentType">
    <xs:annotation>
      <xs:documentation>Shopping Request specialization of a Passenger Segment
 Base type definition: 
 Transportation of a passenger on a Dated Operating Segment.
 - [Dated Marketing Segment] (All identifying fields)
 - [Order] Order ID
 - [Individual] (no identifier available)</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="ARNK_Ind" type="IndType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 When TRUE, indicates an ARNK (ARrival uNKown) condition, i.e. a gap between current segment departure and previous segment arrival location, implying an unknown passenger movement.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="Arrival" type="ShoppingRequestTransportArrivalType">
        <xs:annotation>
          <xs:documentation>Shopping Request Specialization of Transport Arrival 
 base type definition:
 The action or process of arriving of a transport vehicle in any place or location.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="CabinType" type="ShoppingRequestCabinTypeType">
        <xs:annotation>
          <xs:documentation>Shopping Request specialisation of Cabin Type
 base type definition:
 Type of compartment of an aircraft, offering specific services (e.g. business class, economy).
 Business Identifier Fields:
 - Cabin Type Code</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="DatedOperatingLeg" type="DatedOperatingLegType">
        <xs:annotation>
          <xs:documentation>The nonstop operation of a transport vehicle between the departure station and the arrival station. Can be used for aircrafts as well as other transport vehicles such as train or bus etc. 
 Business Identifier Fields:
 - (Operating) [Carrier] Airline Designator
 - Operating Carrier Flight Number
 - Operational Suffix
 - [Dated Operating Flight] Flight Identifier Date
 - Scheduled Departure Station
 - Repeat Number.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="Dep" type="ShoppingRequestTransportDepType">
        <xs:annotation>
          <xs:documentation>Shopping Request specialisation of Transport Departure
 Base type defintition:
 The action or process of leaving of a transport vehicle from any place or location.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="Duration" type="DurationType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Total segment time including the combined air time and connection times of any legs.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="MarketingCarrierFlightNumberText" type="FlightNumberTextType">
        <xs:annotation>
          <xs:documentation>The numerical designation of a flight as it is marketed by a carrier.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="MarketingCarrierInfo" type="ShoppingRequestDatedMarketingSegmentType">
        <xs:annotation>
          <xs:documentation>This is a Shopping Request specialisation of Dated Marketing Segment.
 Base type definition:
 The commercial designation under which a Dated Operating Segment can be booked, either under the operating carrier's designator or that of another carrier (codeshare).
 Business Identifier Fields:
 - (Marketing) [Carrier] Airline Designator
 - Marketing Carrier Flight Number
 - Operational Suffix
 - [Transport Departure] Scheduled Date Time
 - (Transport Departure) [Station] IATA Location Code
 - (Transport Arrival) [Station] IATA Location Code</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="MarketingCarrierRBD" type="RBD_Type">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 when related to Shopping Request Passenger Segment
 Reservation Booking Designator. A categorization used to facilitate access to inventory, application of filed fares, and to identify cabin entitlement. Identified using a single alpha character. E.g. 'J' for Business Class Premium, 'D' for Business Discounted.
 There will typically be several RBDs defined for a given Cabin Type.
 Business Identifier Fields:
 - RBD Code</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="OperatingCarrierInfo" type="ShoppingRequestDatedOperatingSegmentType">
        <xs:annotation>
          <xs:documentation>Shopping Request specialization of Dated Operating Segment
 Base type definition:
 An operation between board point and any subsequent off point within the same flight designator. Could be one or more legs. Could also be used for other transport vehicles such as train or bus etc.
 Business Identifier Fields:
 - (Operating) [Carrier] Airline Designator
 - Operating Carrier Flight Number
 - Operational Suffix
 - [Transport Departure] Scheduled Date Time
 - (Transport Departure) [Station] IATA Location Code
 - (Transport Arrival) [Station] IATA Location Code</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="OperatingCarrierRBD" type="RBD_Type">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 when related to Shopping Request Passenger Segment
 Reservation Booking Designator. A categorization used to facilitate access to inventory, application of filed fares, and to identify cabin entitlement. Identified using a single alpha character. E.g. 'J' for Business Class Premium, 'D' for Business Discounted.
 There will typically be several RBDs defined for a given Cabin Type.
 Business Identifier Fields:
 - RBD Code</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="PaxSegmentID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Uniquely identifies a Passenger Segment within the context of one message.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="SecureFlightInd" type="IndType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 When TRUE, this segment is subject to US TSA 'Secure Flight' passenger prescreening program.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="SegmentTypeCode" type="SegmentTypeCodeType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Defines the operational flight segment type (e.g. Open, Passive, Service).
 
 Encoding Scheme: IATA PADIS 1.4 Codeset FST - Flight Segment Type</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="TicketlessInd" type="IndType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 When TRUE, there are no ticket records, as defined by IATA Resolutions, expected to be issued for this segment.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestSeatType">
    <xs:annotation>
      <xs:documentation>Shopping Request specialization of Seat
 Base type definition:
 A sitting place for a passenger or crew in a cabin compartment on a transport vehicle.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="CharacteristicCode" type="SeatCharacteristicCodeType">
        <xs:annotation>
          <xs:documentation>Seat characteristic/property code (e.g. A - Aisle Seat, W - Window Seat, etc.) using PADIS Codeset 9825.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ColumnID" type="ColumnID_Type">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Alphabetic character identifying a seat within a row.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="SeatProfile" type="SeatProfileType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 when related to Shopping Request Seat
 Airline defined group of seats sharing common characteristics.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestServiceType">
    <xs:annotation>
      <xs:documentation>This is a specialized offer used in the context of a Shopping Request.
 Generic definition is:
 The instance of a specific flight or Service Definition as it has been offered (and eventually ordered and consumed) in the context of a specific Offer and/or Order.
 At the time of shopping, a service can be sold to multiple passengers on a given journey. 
 At time of order, the services should be applied to a single passenger on a single segment.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="AccountingCode" type="CodeType">
        <xs:annotation>
          <xs:documentation>Grouping of services might be mapped to RFIC</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="AccountingSubCode" type="CodeType">
        <xs:annotation>
          <xs:documentation>Service identifier might be mapped to RFISC</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ActionCode" type="ActionCodeType">
        <xs:annotation>
          <xs:documentation>To indicate the creation, update and removal of a service</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="3" name="BookingRef" type="BookingRefType">
        <xs:annotation>
          <xs:documentation>Information related to a booking or reservation.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="BookingStatusCode" type="ServiceBookingStatusCodeType">
        <xs:annotation>
          <xs:documentation>Indicates the current status of a Service booking.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="DatedOperatingLegRef" type="DatedOperatingLegRefType">
        <xs:annotation>
          <xs:documentation>Reference to a Dated Operating Leg within this message</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="DeliveryCode" type="CodeType">
        <xs:annotation>
          <xs:documentation>Grouping of services on delivery aspects</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="DeliveryMilestoneCode" type="CodeType">
        <xs:annotation>
          <xs:documentation>Records an event in the lifecycle of a service delivery that may or may not occur independently of a change of service status, e.g. passenger boarded, passenger accepted airside, bag loaded or offloaded.
 Exploratory functionality</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="DeliveryStatusCode" type="ServiceDeliveryStatusCodeType">
        <xs:annotation>
          <xs:documentation>Indicates the current status of a Service delivery</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="DeliveryStatusDescText" type="TextType">
        <xs:annotation>
          <xs:documentation>To allow passing information in addition to Service Delivery Status</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="DescText" type="TextType">
        <xs:annotation>
          <xs:documentation>Free text for textual description.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ExpirationDateTime" type="DateTimeType">
        <xs:annotation>
          <xs:documentation>Used to recognize the expiration of a service delivery
 e.g. lounge pass expiry date.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="InventoryGuaranteeTimeLimitDateTime" type="DateTimeType">
        <xs:annotation>
          <xs:documentation>The length of time inventory against a given Service is guaranteed. If inventory is not guaranteed, the Order creation (or change) may fail. In the absence of a time limit, no inventory is guaranteed. 
 
 Notes: 
 The presence of an inventory guarantee does not assume a guarantee of price. For the price to be guaranteed against a given Offer Item, the Price Guarantee Time Limit must also be present.
 
 The assumption is that inventory is held when an Order is created (or changed), so this time limit only applies in the context of an Offer.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="unbounded" name="PaxRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to a Passenger ID within this message</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="ServiceDefinitionRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to a service definition.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="ServiceID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Uniquely Identifies a Service within the context of one message.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ServiceRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to another service instance.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="StatusCode" type="CodeType">
        <xs:annotation>
          <xs:documentation>Status of the Service instance. See PADIS Codelist 4405 for possible values.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ValidatingCarrierCode" type="AirlineDesigCodeType">
        <xs:annotation>
          <xs:documentation>Airline code assigned to a carrier. Either ICAO-defined 3-character code or IATA-defined 2-character code.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestTransportArrivalType">
    <xs:annotation>
      <xs:documentation>Shopping Request Specialization of Transport Arrival 
 base type definition:
 The action or process of arriving of a transport vehicle in any place or location.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="AircraftScheduledDateTime" type="DateTimeType">
        <xs:annotation>
          <xs:documentation>The Scheduled Date and Time of Arrival of the aircraft at the terminal or departure gate at an airport.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="BoardingGateID" type="BoardingGateID_Type">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Identifier of the gate. E.g. 'A5'.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="IATA_LocationCode" type="IATA_LocationCodeType">
        <xs:annotation>
          <xs:documentation>IATA 3-letter code defining the city or airport code.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="StationName" type="StationNameType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Name of the station. E.g. George Bush Intercontinental Airport</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="TerminalName" type="NameType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 The name of the terminal.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingRequestTransportDepType">
    <xs:annotation>
      <xs:documentation>Shopping Request specialisation of Transport Departure
 Base type defintition:
 The action or process of leaving of a transport vehicle from any place or location.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="1" name="AircraftScheduledDateTime" type="DateTimeType">
        <xs:annotation>
          <xs:documentation>The Scheduled Date and Time of Departure of the aircraft at the terminal or departure gate at an airport.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="BoardingGateID" type="BoardingGateID_Type">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Identifier of the gate. E.g. 'A5'.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="IATA_LocationCode" type="IATA_LocationCodeType">
        <xs:annotation>
          <xs:documentation>IATA 3-letter code defining the city or airport code.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="StationName" type="NameType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 Name of the station. E.g. George Bush Intercontinental Airport</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="TerminalName" type="NameType">
        <xs:annotation>
          <xs:documentation>DEPRECATE IN 21.1 The name of the terminal.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShoppingResponseType">
    <xs:annotation>
      <xs:documentation>Facilitates the tracking of what was Offered and contains an identifier unique to the source Airline for a set of product Offers returned in response to a shopping request.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="OfferRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to an Offer ID for which this Payment applies.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="OwnerCode" type="AirlineDesigCodeType">
        <xs:annotation>
          <xs:documentation>Airline code assigned to a carrier. Either ICAO-defined 3-character code or IATA-defined 2-character code.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ShoppingResponseRefID" type="ID_Type">
        <xs:annotation>
          <xs:documentation>Reference to unique shopping session response ID, as provided in the airline's previous shopping response.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="SpecialServiceType">
    <xs:annotation>
      <xs:documentation>Special service information</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="AddlDataMeasure" type="MeasureType">
        <xs:annotation>
          <xs:documentation>Provides additional supporting measurement information in case the Special Service requires it.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="FreeText" type="TextType">
        <xs:annotation>
          <xs:documentation>Free text</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="Qty" type="QtyType">
        <xs:annotation>
          <xs:documentation>A quantity is a counted number of non-monetary units, possibly including fractions.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="SpecialServiceCode" type="CodeType">
        <xs:annotation>
          <xs:documentation>Code that identifies the special service.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="StationNameType">
    <xs:annotation>
      <xs:documentation>Data type information for Station Name.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:token">
      <xs:minLength value="1" />
      <xs:maxLength value="256" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="StationType">
    <xs:annotation>
      <xs:documentation>Location or facility where air or surface transportation originates, stops and/or terminates, and where passengers and/or cargo can be taken on or off. 
 Those of relevance to the airline industry are identified by an IATA Location Identifier (3 letter location identifier). There are also additional airports without an IATA identifier that may be used in disruption scenarios that will be identified by an ICAO 4 letter code (assigned to every registered airport, military or civil).
 Business Identifier Fields:
 - IATA Location Code</xs:documentation>
