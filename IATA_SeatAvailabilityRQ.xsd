        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="BirthplaceText" type="TextType">
        <xs:annotation>
          <xs:documentation>Holder's birth location (e.g. city and/or country) as written on the document.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="CitizenshipCountryCode" type="CountryCodeType">
        <xs:annotation>
          <xs:documentation>ISO Country Code (can be extended by bilateral agreement in case of exceptions, e.g. Kosovo). Examples: US, FR.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="ExpiryDate" type="DateType">
        <xs:annotation>
          <xs:documentation>The date the identity document expires.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="1" name="GenderCode" type="GenderCodeType">
        <xs:annotation>
          <xs:documentation>Gender of the individual. Refer to PADIS Codeset 6353.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="0" maxOccurs="5" name="GivenName" type="ProperNameType">
        <xs:annotation>
          <xs:documentation>Holder's first or given name, as written on the document. E.g. JOHN.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="IdentityDocID" type="ID_Type">
